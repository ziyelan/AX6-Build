CONFIG_TARGET_ipq807x=y
CONFIG_TARGET_ipq807x_generic=y
CONFIG_TARGET_ipq807x_generic_DEVICE_xiaomi_redmi-router-ax6-ubootmod=y

# 移除无用服务 (节省后台资源)
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-hd-idle is not set

# 集成 Mihomo 核心代理服务
CONFIG_PACKAGE_luci-app-mihomo=y
CONFIG_PACKAGE_luci-i18n-mihomo-zh-cn=y

# 集成 Tailscale 内网穿透服务
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y

# 集成 iStore 官方应用市场
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-i18n-istorex-zh-cn=y

# 默认主题
CONFIG_PACKAGE_luci-theme-argon=y

# 集成 Turbo ACC 网络加速 (推荐仅开启 BBR 与 DNS 加速)
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
